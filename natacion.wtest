import natacion.*
describe "natacion" {
  const pecho = new Estilo( esRelajante = true, descuento = 2 )
  const crol = new Estilo( esRelajante = false, descuento = 2 )
  const espalda = new Estilo( esRelajante = true, descuento = 1 )
  const mariposa = new Estilo( esRelajante = false, descuento = 3 )

  const debi = new DocenteBásico( esGuardavida = false ) // una docente básica que no es guardavida
  const isa = new DocenteBásico( esGuardavida = true ) // un docente básico que sí es guardavida
  const nico = new DocenteDedicado( esGuardavida = false, estilo = pecho ) // un docente dedicado al estilo pecho que no es guardavida
  const mara = new DocenteExterno( esGuardavida = false, límiteMáximoEstudiantes = 2 )// una docente externa que no es guardavida y acepta hasta 2 estudiantes menores de 13 años por curso

  const milena = new Estudiante( edad = 10, estilosDominados = #{ crol, pecho } ) // Una estudiante de edad 10 que domina los estilos croll y pecho
  const rodrigo = new Estudiante( edad = 9, estilosDominados = #{ mariposa, pecho } ) // Un estudiante de edad 9 domina los estilos mariposa y pecho
  const matilda =  new Estudiante( edad = 9, estilosDominados = #{ crol, pecho } ) // Un estudiante de edad 9 que domina los estilos croll y pecho
  const elias =  new Estudiante( edad = 15, estilosDominados = #{} ) // Un estudiante de edad 15 que no domina ningún estilo
  const camilo =  new Estudiante( edad = 16, estilosDominados = #{ crol, pecho, espalda } ) // Un estudiante de edad 16 que domina los estilos croll, pecho y espalda
  const juana =  new Estudiante( edad = 16, estilosDominados = #{ crol } ) // Una estudiante de edad 16 que domina el estilo croll

  const martes = new CursoBase( docenteAsignado = debi, cupoMáximo = 3, estudiantesInscriptos = #{milena, rodrigo} ) // Un curso base que tiene a debi como docente, el cupo máximo es 3 y tiene como inscriptos a milena y rodrigo
  const jueves = new CursoBase( docenteAsignado = isa, cupoMáximo = 3, estudiantesInscriptos = #{milena, rodrigo} ) // Un curso base que tiene a isa como docente, el cupo máximo es 3 y tiene inscriptos a milena y rodrigo
  const viernes = new CursoBase( docenteAsignado = nico, cupoMáximo = 3, estudiantesInscriptos = #{milena, rodrigo} ) // Un curso base que tiene a nico como docente, el cupo máximo es 3 y tiene inscripto a milena y rodrigo
  const colonia = new CursoEscuelita( docenteAsignado = debi, cupoMáximo = 3, estudiantesInscriptos = #{milena, rodrigo} ) // Un curso escuela de niños que tiene a debi como docente, el cupo máximo es 3 y tiene inscriptos a milena y rodrigo
  const rehabilitacion = new CursoTerapéutico( docenteAsignado = mara, cupoMáximo = 4, estudiantesInscriptos = #{milena, camilo}, recaudaciónBruta = 300 ) // un curso terapéutico que tiene a mara como docente, el cupo máximo es 4, y tiene inscriptos a milena y camilo. Para el punto 2, la recaudacion bruta es de 300

  const toninas = new Escuela( dineroGuardado = 1000, cursos = #{martes, jueves, viernes, colonia, rehabilitacion} ) // Es una escuela que tiene 1000 de dinero guardado y dicta los cursos martes, jueves, viernes, colonia y rehabilitacion

  test "1. a. curso basico (no guardavida)" {
    assert.notThat( martes.puedeInscribir(milena) ) //- milena no puede inscribirse al curso de los martes (porque ya está inscripta)
    assert.that( martes.puedeInscribir(matilda) ) //- En cambio, matilda sí se puede inscribir a los cursos de los martes
    assert.that( martes.puedeInscribir(camilo) ) //- camilo también se puede inscribir al curso de los martes
    assert.notThat( martes.puedeInscribir(elias) ) //- Pero Elías no se puede inscribir al curso de los martes (porque no sabe ningún estilo y debi no es guardavida)

    assert.throwsException( { martes.inscribirEstudiante(elias) } ) //-Al intentar inscribir a elias en el curso de los martes estamos en un problema, porque no se debería permitir
    martes.inscribirEstudiante(matilda) //-Inscribir a matilda en el curso de los martes (no ocurre ningún problema)
    assert.equals( #{ milena, rodrigo, matilda }, martes.estudiantesInscriptos() ) //-Luego de haber incripto a matilda, los nuevos inscriptos del curso de los martes son milena, rodrigo y matilda
    assert.notThat( martes.puedeInscribir(camilo) ) //-Como ahora se completó el curso, camilo ya no puede ser inscripto. 
  }

  test "1. b. curso basico (guardavida)" {
    assert.that( jueves.puedeInscribir(elias) ) // - En el curso de los jueves sí se puede inscribir elias (no sabe ningún estilo pero isa es guardavida)
    jueves.inscribirEstudiante(elias)
    assert.equals( #{ milena, rodrigo, elias }, jueves.estudiantesInscriptos() ) // - Luego de incribir a elías en el curso de los jueves, los inscriptos de dicho curso son milena, rodrigo y elias 
  }

  test "1. c. curso basico docente dedicado" {
    assert.notThat( viernes.puedeInscribir(milena) ) // - En el curso de los viernes no se pude inscribir a milena (ya está inscripta)
    assert.that( viernes.puedeInscribir(matilda) ) // - Pero matilda sí puede ser inscripta en el curso de los viernes
    assert.that( viernes.puedeInscribir(camilo) ) // - Camilo también puede ser inscripto en el curso de los viernes
    assert.notThat( viernes.puedeInscribir(juana) ) // - Quien no puede ser inscripta en el curso de los viernes es juana (porque no domina el estilo pecho)
    assert.throwsException( { viernes.inscribirA(juana) } ) // - Por lo tanto si se intenta inscribir a juana en el curso de los viernes estamos en un problema
    viernes.inscribirEstudiante(matilda)
    assert.equals( #{milena, rodrigo, matilda}, viernes.estudiantesInscriptos() ) // - Al inscribir a matilda en el curso de los viernes, los nuevos inscriptos de ese curso son milena, rodrigo y matilda
    assert.notThat( viernes.puedeInscribir(camilo) ) //     // - Ahora camilo ya no puede ser inscripto (se completo el cupo)
    assert.throwsException( { viernes.inscribirA(camilo) } ) // - Si intentás  inscribir a camilo estamos en un problema, porque no se puede
  }

  test "1. d. escuela de niños" {
    assert.notThat( colonia.puedeInscribir(milena) ) // milena no se puede inscribir en la colonia (ya está inscripta)
    assert.that( colonia.puedeInscribir(matilda) ) // matilda sí se puede inscribir en la colonia 
    assert.notThat( colonia.puedeInscribir(camilo) ) // camilo no se puede inscribir en la colonia (es muy grande)
    assert.notThat( colonia.puedeInscribir(elias) ) // elias no se puede inscribir en la colonia (no sabe ningún estilo y debi no es guardavida)
    assert.throwsException( { colonia.inscribirEstudiante(camilo) } ) // Se intenta inscribir a camilo a la colonia, pero estamos en un problema porque no se puede!
    assert.throwsException( { colonia.inscribirEstudiante(elias) } ) // Se intenta inscribir a elias a la colonia, pero estamos en un problema porque no se puede!
    colonia.inscribirEstudiante(matilda) // Se inscribe a matilda a la colonia sin problema
    assert.equals( #{milena, rodrigo, matilda}, colonia.estudiantesInscriptos() ) // Los inscriptos a la colonia ahora son milena, rodrigo y matilda
  }

test "1. e. terapeutico (docente externo)" {
    assert.notThat( rehabilitacion.puedeInscribir(milena) ) // milena no se puede inscribir a la rehabilitacion (ya está inscripta)
    assert.notThat( rehabilitacion.puedeInscribir(juana) ) // juana no se puede inscribir a la rehabilitación (no domina ningún estilo relajante)
    assert.that( rehabilitacion.puedeInscribir(matilda) ) // matilda sí se puede inscribir a la rehabilitación 
    assert.that( rehabilitacion.puedeInscribir(rodrigo) ) // rodrigo sí se puede inscribir a la rehabilitación 
    rehabilitacion.inscribirEstudiante(matilda) // inscribir a matilda a la rehabilitación (se puede sin problemas)
    assert.throwsException( { rehabilitacion.inscribirEstudiante(rodrigo) } ) // Ahora si se intenta inscribir a rodrigo estaríamos en un problema porque se llegó al límite de menores de 13 que acepta mara
    assert.equals( #{milena, camilo, matilda}, rehabilitacion.estudiantesInscriptos() ) // Los inscriptos a la rehabilitación son milena, camilo y matilda
}

  //punto 2

  test "2. recaudacion" {
    assert.equals( 7.9, martes.recaudaciónDelCurso() ) // Asegurarse que la reacudación de los martes y la de los jueves es 7.9        
    assert.equals( 7.9, jueves.recaudaciónDelCurso() )
    // Si las cuentas no te dan, estos son los parciales:
    //  por milena = 20 - 2 - 2 = 16
    //  por rodrigo = rodrigo =  20 - 2 -3 =  15
    //  bruta = 16 + 15 = 31
    //  debi/isa = 20 + 31 * 0.1 = 20 + 3.1 = 23.1 
    //  total =  31 - 23.1 = 7.9 
  

    assert.equals( 6.35, viernes.recaudaciónDelCurso() ) // Asegurarse que la recaudación del curso de los viernes es 6.35
    // Si las cuentas no te dan, éstos son los parciales:
    //  por milena = 20 - 2 - 2 = 16
    //  por rodrigo =  20 - 2 -3 =  15
    //  bruta = 16 + 15 = 31
    //  nico = 20 + 31 * 0.15 = 20 + 4.65 = 24.65
    // total = 31 - 24.65 = 6.35
    
    
    assert.equals( 457.9, colonia.recaudaciónDelCurso() ) // Asegurarse que la recaudación del curso colonia 457.9
    // Si las cuentas no te dan, éstos son los parciales:
    //  por milena = 20 - 2 - 2 = 16
    //  por rodrigo = rodrigo =  20 - 2 -3 =  15
    //  bruta = 500 + 16 + 15 = 531
    //  debi = 20 + 531 * 0.1 = 20 + 53.1 = 73.1 
    //  total = 531 - 73.1 = 447.9
    
    assert.equals( 244, rehabilitacion.recaudaciónDelCurso() ) // Asegurarse que la recaudación de la rehabilitación es 244
    // Si las cuentas no te dan, éstoso son los parciales:
    //  bruta = 300
    //  mara = 20 + 300 * 0.1 + 3 * 2 = 20 + 30 + 6 = 56
    //  total = 300 - 56 = 244

    assert.equals( 724.05, toninas.recaudaciónMensual() ) // Asegurarse que la recaudación de la escuela toninas es 724.05
    // Si las cuentas no te dan, acá están los valores: 7.9 + 7.9 + 6.35 + 457.9 + 244 = 724.05
    
    toninas.cobrarRecaudaciónMensual() // - cobrar la recaudación mensual de la escuela toninas
    assert.equals( 1724.05, toninas.dineroGuardado() ) // - el total de dinero guardado en la escuela es 1724.05
    
    toninas.cobrarRecaudaciónMensual() // - cobrar nuevamente la recaudación mensual de la escuela toninas
    assert.equals( 2448.1, toninas.dineroGuardado() ) // - el total de dinero guardado en la escuela es ahora 2448.1
  }

//punto 3
  test "3. consultas" {
    assert.equals( rehabilitacion, toninas.cursoConElEstilo(espalda) ) // Buscar un curso con el estilo espalda en la escuela toninas: La única opción posible es rehabilitación
    viernes.inscribirEstudiante(camilo) // Inscribir a camilo en el curso de los viernes
    assert.equals( #{martes, jueves, colonia}, toninas.cursosInfantiles() ) // Los cursos infantiles de la escuela toninas son martes, jueves y colonia
    assert.equals( #{debi,isa,debi}, toninas.docentesDeCursosInfantiles() ) // Los docentes de los cursos infantiles de la escuela toninas son debi e isa    
  }
}
